# ----------------------------------------------------------------- Banco ----
# Connection string do Neon (projeto "karate"). Console › Connection Details.
DATABASE_URL="postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------- Mercado Pago ----
# Credenciais › Access Token. Use o de TESTE enquanto valida o fluxo.
MERCADOPAGO_ACCESS_TOKEN="TEST-0000000000000000-000000-xxxxxxxx-000000000"
# URL pública que recebe as notificações (ngrok em dev, domínio em produção).
MERCADOPAGO_WEBHOOK_URL="https://seu-dominio.com/api/webhooks/mercadopago"
# Segredo da assinatura do webhook (Suas integrações › Webhooks).
# Sem ele a validação de assinatura é pulada — nunca deixe vazio em produção.
MERCADOPAGO_WEBHOOK_SECRET=""

# ----------------------------------------------------------------- Stripe ---
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# -------------------------------------------------------------- Aplicação ---
APP_URL="http://localhost:3000"
# Mensalidade em centavos (R$ 50,00).
VALOR_MENSALIDADE_CENTAVOS="1"
# Mesmo valor exposto ao navegador (telas de mensalidade).
NP_MENSALIDADE_CENTAVOS="1"
# Segredo que assina o cookie de sessão (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="troque-por-uma-string-longa-e-aleatoria-de-48-bytes"

# Segredo do cron da Vercel (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET="troque-por-uma-string-longa-e-aleatoria"

# ------------------------------------------------- Endereços (subdomínios) ---
# Só em produção. Com as três URLs, o middleware separa as partes pelo
# endereço e os links entre elas viram absolutos. Vazias (localhost e
# previews), tudo continua num endereço só.
NEXT_PUBLIC_URL_SITE=
NEXT_PUBLIC_URL_ACADEMY=
NEXT_PUBLIC_URL_PORTAL=
# Produção:
#   NEXT_PUBLIC_URL_SITE="https://torakandojo.com"
#   NEXT_PUBLIC_URL_ACADEMY="https://academy.torakandojo.com"
#   NEXT_PUBLIC_URL_PORTAL="https://portal.torakandojo.com"
# Domínio do cookie de sessão, para o login valer no portal e no academy.
# Produção: COOKIE_DOMAIN="torakandojo.com". Vazio no localhost.
COOKIE_DOMAIN=
# Em produção, APP_URL deve ser o portal (checkout e webhooks voltam para ele).

# ------------------------------------------- Captcha do login (Turnstile) ---
# Cloudflare › Turnstile › widget "Torakan – login". Vazias no localhost: o
# código usa as chaves de teste da Cloudflare, que sempre passam.
# A secreta fica só na Vercel (tipo Sensitive), nunca no navegador.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------- Login com Google ---
# Google Cloud Console › APIs e serviços › Credenciais › ID do cliente OAuth
# (tipo "Aplicativo da Web"). Em "URIs de redirecionamento autorizados",
# cadastre um por ambiente, exatamente assim:
#   http://localhost:3000/api/auth/google/callback
#   https://torakan-academy-hml.vercel.app/api/auth/google/callback
#   https://torakan-academy.vercel.app/api/auth/google/callback
# Sem estas duas variáveis o botão "Entrar com Google" não aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
